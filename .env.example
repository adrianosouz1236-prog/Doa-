# =====================================================================
# APP - CONFIGURAÇÕES GERAIS
# =====================================================================
FLASK_ENV=development
SECRET_KEY=sua-chave-secreta-aqui-mude-em-producao
JWT_SECRET_KEY=jwt-chave-secreta-mude
JWT_EXPIRES_HOURS=2
DEBUG=True
HOST=0.0.0.0
PORT=5000

# =====================================================================
# SEGURANÇA
# =====================================================================
FERNET_KEY=sua_chave_fernet_aqui
RECAPTCHA_SITE_KEY=sua_site_key
RECAPTCHA_SECRET_KEY=sua_secret_key

# =====================================================================
# BANCO DE DADOS
# =====================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=doacoes_db

# =====================================================================
# FINANCEIRO (Sistema interno)
# =====================================================================
TAXA_PROCESSAMENTO=3.99
TAXA_FIXA=0.60
SAQUE_MINIMO=10.00
PRAZO_SAQUE_DIAS=3

# =====================================================================
# CORS
# =====================================================================
CORS_ORIGINS=*

# =====================================================================
# LOGS
# =====================================================================
LOG_LEVEL=INFO

# =====================================================================
# GOOGLE MAPS
# =====================================================================
GOOGLE_MAPS_API_KEY=sua_chave_google_maps

# =====================================================================
# EMAIL (para produção)
# =====================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# =====================================================================
# CONTA DA PLATAFORMA (para saques)
# =====================================================================
PLATAFORMA_BANCO=Banco do Brasil
PLATAFORMA_AGENCIA=1234
PLATAFORMA_CONTA=12345-6
PLATAFORMA_TITULAR=Doa+ Plataforma
PLATAFORMA_CNPJ=00.000.000/0001-00

# =====================================================================
# MERCADO PAGO - INTEGRAÇÃO DE DOAÇÕES
# =====================================================================
# 🔑 Obtenha suas credenciais em: https://www.mercadopago.com.br/developers
#
# Para desenvolvimento (sandbox), use tokens que começam com TEST-
# Para produção, use tokens que começam com APP_USR-
#
# Como obter:
# 1. Acesse https://www.mercadopago.com.br/developers
# 2. Faça login com sua conta Mercado Pago
# 3. Vá em "Suas integrações" -> "Credenciais"
# 4. Copie o Access Token e Public Key
#
# Importante:
# - Nunca compartilhe seu Access Token
# - Não comite este arquivo no repositório
# - Adicione .env ao .gitignore

MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_STATEMENT_DESCRIPTOR=Doa+ Doações

# =====================================================================
# TAXAS DA PLATAFORMA (Mercado Pago)
# =====================================================================
# Taxa cobrada por doação via Mercado Pago
# O valor é deduzido automaticamente antes de creditar na ONG
TAXA_SERVICO=3.99
TAXA_FIXA=0.60

# =====================================================================
# WEBHOOK DO MERCADO PAGO
# =====================================================================
# URL onde o Mercado Pago enviará notificações de status
# Em produção, substitua pelo seu domínio real
# Exemplo: https://seudominio.com/webhook/mercadopago
MP_WEBHOOK_URL=http://localhost:5000/webhook/mercadopago

# =====================================================================
# CONFIGURAÇÕES ADICIONAIS DO MERCADO PAGO
# =====================================================================
# Modo binário: true = só aprovado ou recusado (sem pendência)
MP_BINARY_MODE=False

# Retorno automático após pagamento
MP_AUTO_RETURN=approved

# Número máximo de parcelas
MP_INSTALLMENTS=12

# =====================================================================
# ADMIN (para notificações de segurança)
# =====================================================================
ADMIN_EMAIL=admin@doamais.org
ADMIN_PASSWORD_HASH=admin123

# =====================================================================
# URL BASE DA APLICAÇÃO
# =====================================================================
# Em produção, use https://seudominio.com
# Em desenvolvimento, use http://localhost:5000
BASE_URL=http://localhost:5000